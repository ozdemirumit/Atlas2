# Project Atlas Configuration Baseline
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 18 Profile)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password_change_me
POSTGRES_DB=atlas_db

# Development Identity Provider (ADR-003)
# Enabled ONLY in development and test environments
ENABLE_DEV_IDENTITY=true
DEV_IDENTITY_SUBJECT=local-operator
DEV_IDENTITY_NAME=Local Operator
DEV_IDENTITY_ROLES=C0_OPERATOR
DEV_IDENTITY_SCOPES=identity.self.read

# ─── OpenAI-Compatible LLM ───────────────────────────────────────────────────
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://heimdall-devxk.com.tr/v1
LLM_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
LLM_MODEL=qwen3-5-vl
LLM_TIMEOUT=120
MAX_TOOL_ROUNDS=10
LLM_TEMPERATURE=0.1
